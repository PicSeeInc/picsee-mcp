{
  "name": "picsee-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server exposing the PicSee URL Shortener API.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "lambda:bundle": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/lambda.mjs",
    "lambda:build": "sam build",
    "lambda:deploy": "sam deploy --guided"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
